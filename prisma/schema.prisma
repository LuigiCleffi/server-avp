generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  USER
  ADMIN
  GAME_CREATOR
}

model Account {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  role                AccountRole          @default(USER)
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("password_reset_tokens")
}

model MercadoLivreCredential {
  sellerId     String   @id @map("seller_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("ml_credentials")
}

model MercadoLivreOrder {
  orderId      BigInt    @id @map("order_id")
  sellerId     String    @map("seller_id")
  status       String
  totalAmount  Decimal   @map("total_amount") @db.Decimal(18, 2)
  items        Json
  shippingId   BigInt?   @map("shipping_id")
  packId       BigInt?   @map("pack_id")
  nfeStatus    String    @default("pending") @map("nfe_status")
  rawPayload   Json?     @map("raw_payload")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([status])
  @@index([shippingId])
  @@index([packId])
  @@index([nfeStatus])
  @@map("ml_orders")
}
