// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum UserRole {
  USER
  ADMIN
  GAME_CREATOR
}

enum CreatorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum PaymentProvider {
  STRIPE
  CRYPTO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum TournamentPurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum GameApiKeyStatus {
  ACTIVE
  REVOKED
}

enum MatchType {
  REGULAR
  SEMI_FINAL
  FINAL
  THIRD_PLACE
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  email            String             @unique
  password         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  role             UserRole           @default(USER)
  gamesCreated     Game[]
  wallet           Wallet?
  tournamentPurchases TournamentPurchase[]
  creatorRequests  CreatorRequest[]
  passwordResetTokens PasswordResetToken[]
  tournaments      Tournament[]       // Tournaments created by the user (e.g., as organizer)
  participants     Participant[]      // Tournaments the user participates in
  tournamentRequests TournamentRequest[] // Tournament requests made by the user
  reviewedRequests TournamentRequest[] @relation("ReviewedRequests") // Requests reviewed by admin
  reviewedCreatorRequests CreatorRequest[] @relation("ReviewedCreatorRequests")

  @@map("users")
}

model CreatorRequest {
  id            String               @id @default(uuid()) @db.Uuid
  requestedBy   User                 @relation(fields: [requestedById], references: [id])
  requestedById String               @map("requested_by_id") @db.Uuid
  status        CreatorRequestStatus @default(PENDING)
  adminNotes    String?              @map("admin_notes")
  reviewedAt    DateTime?            @map("reviewed_at")
  reviewedBy    User?                @relation("ReviewedCreatorRequests", fields: [reviewedById], references: [id])
  reviewedById  String?              @map("reviewed_by_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@unique([requestedById])
  @@map("creator_requests")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique @map("user_id") @db.Uuid
  currency  String   @default("USD")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]
  payments      Payment[]

  @@map("wallets")
}

model LedgerEntry {
  id        String          @id @default(uuid()) @db.Uuid
  wallet    Wallet          @relation(fields: [walletId], references: [id])
  walletId  String          @map("wallet_id") @db.Uuid
  type      LedgerEntryType
  amount    Decimal         @db.Decimal(10, 2)
  currency  String
  reason    String

  payment   Payment?        @relation(fields: [paymentId], references: [id])
  paymentId String?         @unique @map("payment_id") @db.Uuid

  tournamentPurchase   TournamentPurchase? @relation(fields: [tournamentPurchaseId], references: [id])
  tournamentPurchaseId String?             @unique @map("tournament_purchase_id") @db.Uuid

  createdAt DateTime        @default(now()) @map("created_at")

  @@index([walletId, createdAt])
  @@map("ledger_entries")
}

model Payment {
  id         String          @id @default(uuid()) @db.Uuid
  wallet     Wallet          @relation(fields: [walletId], references: [id])
  walletId   String          @map("wallet_id") @db.Uuid
  provider   PaymentProvider
  status     PaymentStatus   @default(PENDING)
  externalId String?         @unique @map("external_id")
  amount     Decimal         @db.Decimal(10, 2)
  currency   String
  metadata   Json?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  ledgerEntry LedgerEntry?

  @@index([walletId, createdAt])
  @@map("payments")
}

model WebhookEvent {
  id         String          @id @default(uuid()) @db.Uuid
  provider   PaymentProvider
  externalId String          @map("external_id")
  payload    Json
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([provider, externalId])
  @@map("webhook_events")
}

enum GameGenre {
  FIGHTING
  SHOOTER
  STRATEGY
  RPG
  SPORTS
  PUZZLE
  ADVENTURE
}

model Game {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @unique
  description        String?
  genre              GameGenre
  active             Boolean            @default(true)
  createdBy          User?              @relation(fields: [createdById], references: [id])
  createdById        String?            @map("created_by_id") @db.Uuid
  apiKeys            GameApiKey[]
  sdkEvents          SdkEvent[]
  tournaments        Tournament[]
  tournamentRequests TournamentRequest[]

  @@map("games")
}

model GameApiKey {
  id         String          @id @default(uuid()) @db.Uuid
  game       Game            @relation(fields: [gameId], references: [id])
  gameId     String          @map("game_id") @db.Uuid
  clientId   String          @unique @map("client_id")
  secretHash String          @map("secret_hash")
  status     GameApiKeyStatus @default(ACTIVE)
  createdAt  DateTime        @default(now()) @map("created_at")
  revokedAt  DateTime?       @map("revoked_at")
  lastUsedAt DateTime?       @map("last_used_at")

  sdkNonces  SdkRequestNonce[]
  sdkEvents  SdkEvent[]

  @@index([gameId, status])
  @@map("game_api_keys")
}

model SdkRequestNonce {
  id        String    @id @default(uuid()) @db.Uuid
  apiKey    GameApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  apiKeyId  String    @map("api_key_id") @db.Uuid
  nonce     String
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([apiKeyId, nonce])
  @@map("sdk_request_nonces")
}

model SdkEvent {
  id         String    @id @default(uuid()) @db.Uuid
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId     String    @map("game_id") @db.Uuid
  apiKey     GameApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  apiKeyId   String    @map("api_key_id") @db.Uuid
  eventId    String    @map("event_id")
  type       String
  playerId   String?   @map("player_id")
  payload    Json
  occurredAt DateTime  @map("occurred_at")
  receivedAt DateTime  @default(now()) @map("received_at")

  @@unique([gameId, eventId])
  @@index([gameId, receivedAt])
  @@index([gameId, playerId, receivedAt])
  @@map("sdk_events")
}

model Tournament {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  fee          Decimal      @db.Decimal(10, 2)
  prizePool    Decimal      @db.Decimal(10, 2)
  format       TournamentFormat @default(SINGLE_ELIMINATION)
  maxParticipants Int            @map("max_participants")
  status          TournamentStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  userId          String           @map("user_id") @db.Uuid
  game         Game          @relation(fields: [gameId], references: [id])
  gameId       String        @map("game_id") @db.Uuid
  participants Participant[]
  matches      Match[]
  purchases    TournamentPurchase[]

  @@map("tournaments")
  @@unique([gameId, name])
}

model TournamentPurchase {
  id         String                 @id @default(uuid()) @db.Uuid
  user       User                   @relation(fields: [userId], references: [id])
  userId     String                 @map("user_id") @db.Uuid
  tournament Tournament             @relation(fields: [tournamentId], references: [id])
  tournamentId String               @map("tournament_id") @db.Uuid
  status     TournamentPurchaseStatus @default(PENDING)

  provider   PaymentProvider?
  externalId String?                @unique @map("external_id")
  paidAt     DateTime?              @map("paid_at")

  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  ledgerEntry LedgerEntry?

  @@unique([userId, tournamentId])
  @@index([tournamentId, status])
  @@map("tournament_purchases")
}

model Participant {
  id           String     @id @default(uuid()) @db.Uuid
  user         User       @relation(fields: [userId], references: [id]) // User participating in the tournament
  userId       String     @map("user_id") @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id]) // Tournament they joined
  tournamentId String     @map("tournament_id") @db.Uuid
  joinedAt     DateTime   @default(now())
  wonMatches   Match[]    @relation("MatchWinner")

  @@unique([userId, tournamentId])
  @@map("participants")
}

model Match {
  id            String       @id @default(uuid()) @db.Uuid
  tournament    Tournament   @relation(fields: [tournamentId], references: [id])
  tournamentId  String       @map("tournament_id") @db.Uuid
  round         Int
  winner        Participant? @relation("MatchWinner", fields: [winnerId], references: [id])
  winnerId      String?      @map("winner_id") @db.Uuid
  playedAt      DateTime?
  type          MatchType    @default(REGULAR) // Type of the match (e.g., REGULAR, FINAL, THIRD_PLACE)
  participantId String?

  @@index([tournamentId, round])
  @@map("matches")
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum TournamentStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELED
  PENDING_APPROVAL
}

model TournamentRequest {
  id            Int              @id @default(autoincrement())
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime?
  prizePool     Float            @default(0)
  fee           Float            @default(0)
  maxPlayers    Int
  gameId        String           @db.Uuid
  requestedById String           @db.Uuid
  justification String           // User's justification for the tournament
  adminNotes    String?          // Admin's notes during review
  status        String           @default("PENDING_APPROVAL") // Use string for request status
  reviewedAt    DateTime?
  reviewedById  String?          @db.Uuid
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  game          Game             @relation(fields: [gameId], references: [id])
  requestedBy   User             @relation(fields: [requestedById], references: [id])
  reviewedBy    User?            @relation("ReviewedRequests", fields: [reviewedById], references: [id])

  @@map("tournament_requests")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
