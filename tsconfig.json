{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@/generated/prisma/client": ["generated/prisma/client/client"],
      "@/generated/*": ["generated/*"],
      "@/*": ["src/*"],
      "@src/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": ["src", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
