# Copy to .env and fill values
# Required for local auth API development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/etourney?schema=public"
JWT_SECRET="change-me"

# Optional (defaults shown)
HOST="0.0.0.0"
PORT="3000"

# Optional: kept for future modules that are currently disabled
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: kept for future modules that are currently disabled
TOURNAMENT_MANAGER_BASE_URL=""
TOURNAMENT_MANAGER_API_KEY=""
