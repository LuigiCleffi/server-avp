# Copy to .env and fill values
# Required for local auth API development
DATABASE_URL="postgresql://avp:avp_psw!@localhost:5432/avp_db?schema=public"
AWS_REGION="us-east-1"
RDS_IAM_AUTH_ENABLED="false"
DB_HOST=""
DB_PORT="5432"
DB_NAME=""
DB_USER=""
DB_SSL_ENABLED="false"
DB_SSL_REJECT_UNAUTHORIZED="true"
JWT_SECRET="change-me"
# Public key identifier used as JWT iss claim (Kong key)
JWT_ISSUER="avp-issuer"

# Optional (defaults shown)
HOST="0.0.0.0"
PORT="3000"
POSTGRES_USER="avp"
POSTGRES_PASSWORD="avp_psw!"
POSTGRES_DB="avp_db"
POSTGRES_PORT="5432"
# Optional: use this when running the API via docker compose
# DATABASE_URL_DOCKER="postgresql://avp:avp_psw!@db:5432/avp_db?schema=public"

# Optional: Mercado Livre API Configuration
# Get these values from https://auth.mercadolibre.com.br/
MERCADO_LIVRE_CLIENT_ID=""
MERCADO_LIVRE_CLIENT_SECRET=""
MERCADO_LIVRE_REDIRECT_URI="http://localhost:3000/auth/mercado-livre/callback"
MERCADO_LIVRE_ACCESS_TOKEN=""
MERCADO_LIVRE_REFRESH_TOKEN=""
