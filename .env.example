# Copy to .env and fill values
# Required for local dev (Phase 0)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/etourney?schema=public"
JWT_SECRET="change-me"

# Optional (defaults shown)
HOST="0.0.0.0"
PORT="3000"

# Stripe (Phase 4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Tournament Manager (external)
TOURNAMENT_MANAGER_BASE_URL=""
TOURNAMENT_MANAGER_API_KEY=""

# Crypto (Phase 5)
CRYPTO_PROVIDER=""
CRYPTO_WEBHOOK_SECRET=""

# Email (Phase 2)
MAIL_PROVIDER=""
MAIL_PROVIDER_API_KEY=""
MAIL_FROM="no-reply@etourney.local"
